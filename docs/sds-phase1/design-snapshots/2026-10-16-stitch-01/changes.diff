+      position: sticky;
+      top: 0;
+      z-index: 100;
+    }
+
+    .titlebar-left {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+    }
+
+    .traffic-lights {
+      display: flex;
+      gap: 6px;
+      margin-right: 6px;
+    }
+
+    .traffic-light {
+      width: 10px;
+      height: 10px;
+      border-radius: 50%;
+    }
+    .traffic-light.red { background-color: #ff5f56; }
+    .traffic-light.yellow { background-color: #ffbd2e; }
+    .traffic-light.green { background-color: #27c93f; }
+
+    .app-title {
+      font-weight: 500;
+      color: #334155;
+    }
+
+    .app-version {
+      color: #94a3b8;
+      font-family: 'JetBrains Mono', monospace;
+      font-size: 10px;
+    }
+
+    .titlebar-center {
+      position: absolute;
+      left: 50%;
+      transform: translateX(-50%);
+      font-size: 11px;
+      color: #64748b;
+      display: flex;
+      align-items: center;
+      gap: 6px;
+    }
+
+    .status-dot {
+      width: 6px;
+      height: 6px;
+      border-radius: 50%;
+      background-color: #10b981;
