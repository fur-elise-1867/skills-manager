+      justify-content: space-between;
+    }
+  </style>
+</head>
+<body>
+
+  <!-- Window Chrome Titlebar -->
+  <header class="titlebar">
+    <div class="titlebar-left">
+      <div class="traffic-lights">
+        <span class="traffic-light red"></span>
+        <span class="traffic-light yellow"></span>
+        <span class="traffic-light green"></span>
+      </div>
+      <span class="app-title">Skills Manager — Samsung SDS</span>
+      <span class="app-version">v2.4.1-enterprise</span>
+    </div>
+    <div class="titlebar-center">
+      <span class="status-dot"></span>
+      <span>Workstation Node · Connected</span>
+    </div>
+    <div class="titlebar-right">
+      <span>—</span>
+      <span>□</span>
+      <span>✕</span>
+    </div>
+  </header>
+
+  <div class="app-layout">
+    <!-- Shared Sidebar (225px) -->
+    <aside class="sidebar" aria-label="App navigation">
+      <div>
+        <div class="brand">
+          <span class="brandmark">S</span>
+          <div>
+            <strong>Skills Manager</strong>
+            <small>SAMSUNG SDS</small>
+          </div>
+        </div>
+
+        <nav class="nav-group">
+          <a class="navitem nav-dashboard active" href="#dashboard">
+            <span class="icon">▦</span>Dashboard
+          </a>
+          <a class="navitem nav-library" href="#library">
+            <span class="icon">▤</span>Library<span class="navcount">12</span>
+          </a>
+          <a class="navitem nav-store" href="#store">
+            <span class="icon">↓</span>Skills Store
+          </a>
+          <a class="navitem nav-backup" href="#backup">
+            <span class="icon">◷</span>Backup
+          </a>
+
+          <div class="navlabel">Presets</div>
+          <a class="navitem" href="#workspace">
+            <span class="icon">◇</span>PM Essentials<span class="navcount">3</span>
+          </a>
+          <a class="navitem" href="#workspace">
+            <span class="icon">＋</span>New preset
+          </a>
+
+          <div class="navlabel">Global Workspace</div>
+          <a class="navitem" href="#workspace">
+            <span class="icon">◎</span>All Agents
+          </a>
+          <a class="navitem" href="#workspace">
+            <span class="agentdot aipro">A</span>AIPro<span class="navcount">8</span>
+          </a>
+          <a class="navitem" href="#workspace">
+            <span class="agentdot claude">Cl</span>Claude<span class="navcount">4</span>
+          </a>
+          <a class="navitem" href="#workspace">
+            <span class="agentdot gemini">G</span>Gemini<span class="navcount">3</span>
+          </a>
+          <a class="navitem" href="#workspace">
+            <span class="agentdot codex">Cx</span>Codex<span class="navcount">5</span>
+          </a>
+
+          <div class="navlabel">Project Workspaces</div>
+          <a class="navitem nav-workspace" href="#workspace">
+            <span class="icon">▱</span>Project Atlas<span class="navcount">3</span>
+          </a>
+          <a class="navitem" href="#install">
+            <span class="icon">＋</span>Add project
+          </a>
+        </nav>
+      </div>
+
+      <div class="sidebarfoot">
+        <a class="navitem nav-settings" href="#settings">
+          <span class="icon">⚙</span>Settings
+        </a>
+        <div class="account">
+          <span class="avatar">E</span>
+          <div>
+            Example Employee<br>
+            <span class="muted">Skills Store account</span>
+          </div>
+        </div>
+      </div>
+    </aside>
+
+    <!-- Main Dashboard Viewport -->
+    <main class="main-viewport">
+      <section class="screen" id="dashboard" aria-labelledby="dashboard-title">
+        
+        <!-- Header -->
+        <div class="screenhead">
+          <div>
+            <h1 id="dashboard-title">Welcome to Skills Manager</h1>
+            <p class="muted small">Find useful skills and make them available to your agents.</p>
+          </div>
+          <a class="btn primary" href="#store">Browse Skills Store →</a>
+        </div>
+
+        <!-- Metric Grid -->
+        <div class="metricgrid">
+          <div class="metric-card">
+            <strong>12</strong>
+            <span>Skills in Library</span>
+            <span class="card-icon">▤</span>
+          </div>
+          <div class="metric-card">
+            <strong>4</strong>
+            <span>Agents configured</span>
+            <span class="card-icon">◎</span>
+          </div>
+          <div class="metric-card">
+            <strong>1</strong>
+            <span>Skill update available</span>
+            <span class="card-icon">↓</span>
+          </div>
+        </div>
+
+        <!-- Onboarding Panel: Your first skill, in three steps -->
+        <div class="panel">
+          <div class="panel-header-row">
+            <h2>Your first skill, in three steps</h2>
+            <span class="muted small" style="font-size: 11.5px;">Guided Onboarding</span>
+          </div>
+          <div class="steps-grid">
+            <div class="step-box">
+              <span class="tag blue">1 · Discover</span>
+              <p>Find a skill for your task in the internal Store. Read its instructions and requirements.</p>
+              <div class="step-footer-link">Store Catalog ↗</div>
+            </div>
+            <div class="step-box">
+              <span class="tag blue">2 · Choose</span>
+              <p>Select agents and choose Global for general use, or Project for one workspace.</p>
+              <div class="step-footer-link">Scope Routing ↗</div>
+            </div>
+            <div class="step-box">
+              <span class="tag blue">3 · Install</span>
+              <p>Review AIPro MCP warnings, install and check the result for each destination.</p>
+              <div class="step-footer-link">MCP Verification ↗</div>
+            </div>
+          </div>
+        </div>
+
+        <!-- Two Column Content: Agents & Needs Attention -->
+        <div class="twocol">
+          
+          <!-- Column 1: Your agents -->
+          <div class="panel">
+            <div class="panel-header-row">
+              <h3>Your agents</h3>
+              <span class="tag green">4 of 4 Ready</span>
+            </div>
+            <div class="table-container">
+              <table>
+                <thead>
+                  <tr>
+                    <th>Agent Provider</th>
+                    <th>Protocol</th>
+                    <th>Status</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  <tr>
+                    <td>
+                      <div class="agent-cell">
+                        <span class="agent-pill aipro">A</span>
+                        <span>AIPro</span>
+                      </div>
+                    </td>
+                    <td><span class="protocol-text">MCP v1.2</span></td>
+                    <td><span class="tag green">Detected</span></td>
+                  </tr>
+                  <tr>
+                    <td>
+                      <div class="agent-cell">
+                        <span class="agent-pill claude">Cl</span>
+                        <span>Claude</span>
+                      </div>
+                    </td>
+                    <td><span class="protocol-text">Desktop SDK</span></td>
+                    <td><span class="tag green">Detected</span></td>
+                  </tr>
+                  <tr>
+                    <td>
+                      <div class="agent-cell">
+                        <span class="agent-pill gemini">G</span>
+                        <span>Gemini</span>
+                      </div>
+                    </td>
+                    <td><span class="protocol-text">CLI Daemon</span></td>
+                    <td><span class="tag green">Detected</span></td>
+                  </tr>
+                  <tr>
+                    <td>
+                      <div class="agent-cell">
+                        <span class="agent-pill codex">Cx</span>
+                        <span>Codex</span>
+                      </div>
+                    </td>
+                    <td><span class="protocol-text">Local Runtime</span></td>
+                    <td><span class="tag green">Detected</span></td>
+                  </tr>
+                </tbody>
+              </table>
+            </div>
+            <a class="action-link" href="#settings">Manage agent paths →</a>
+            <div class="panel-footer-note">
+              <span>Paths auto-discovered via system daemon</span>
+              <span>Sync active</span>
+            </div>
+          </div>
+
+          <!-- Column 2: Needs attention -->
+          <div class="panel">
+            <div class="panel-header-row">
+              <h3>Needs attention</h3>
+              <span class="tag amber">2 Action Items</span>
+            </div>
+
+            <!-- Update warning item -->
+            <div class="attention-card">
+              <div class="attention-title">
+                <span>⚠</span>
+                <span>Jira Weekly Report has a new version.</span>
+              </div>
+              <div class="attention-desc">
+                Version 1.2.0 adds blocked-task summaries and clearer next actions.
+              </div>
+              <a class="action-link" href="#update">Review update →</a>
+            </div>
+
+            <hr class="divider">
+
+            <!-- MCP missing item -->
+            <div class="attention-item">
+              <p class="small muted" style="color: #475569; margin-bottom: 8px;">
+                <strong>AIPro is missing the Jira MCP configuration.</strong><br>
+                Required for Jira issue retrieval and sprint milestone rollups.
+              </p>
+              <a class="action-link" href="#mcp">Review requirements →</a>
+            </div>
+
+            <div class="panel-footer-note">
+              <span>Diagnostics check: Just now</span>
+              <span>Local verification only</span>
+            </div>
+          </div>
+
+        </div>
+
+      </section>
+    </main>
+  </div>
+
+</body>
+</html>
