+    }
+
+    /* Window Titlebar */
+    .titlebar {
+      height: 32px;
+      background-color: #ffffff;
+      border-bottom: 1px solid #e1e3e7;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      padding: 0 12px;
+      font-size: 11px;
+      color: #64748b;
